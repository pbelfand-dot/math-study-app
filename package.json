{
  "name": "build-a-hooper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A basketball life simulator. Roll the genetics, then live the career one year at a time from high school through the draft.",
  "scripts": {
    "sim": "node tools/sim.js",
    "dev": "node tools/serve.js",
    "bundle": "node tools/bundle.js",
    "exe": "node tools/build-exe.js --native",
    "exe:node": "node tools/build-exe.js",
    "exe:mac": "node tools/build-exe.js --target darwin-arm64",
    "exe:linux": "node tools/build-exe.js --target linux-x64",
    "fonts": "node tools/fetch-fonts.js",
    "desktop": "npm run bundle && electron .",
    "desktop:win": "npm run bundle && electron-builder --win portable",
    "desktop:installer": "npm run bundle && electron-builder --win nsis",
    "desktop:mac": "npm run bundle && electron-builder --mac dmg",
    "site": "node tools/build-site.js",
    "icons": "node tools/make-icons.js"
  },
  "main": "electron-main.cjs",
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.buildahooper.game",
    "productName": "Hoop Life",
    "files": [
      "electron-main.cjs",
      "dist/build-a-hooper.html"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "HoopLife-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
